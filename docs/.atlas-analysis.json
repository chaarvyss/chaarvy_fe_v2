  "keyFeatures": [
    "Student admissions with multi-step enrollment form",
    "Fee management with payment collection and receipts",
    "Program and curriculum management with segments, mediums, and sections",
    "Attendance tracking with daily register and log history",
    "Faculty schedule planner with calendar view",
    "Question bank and topic management for faculty",
    "Timetable creation and management",
    "Transportation management with live vehicle tracking",
    "Expense and vendor management",
    "Role-based access control with granular permissions",
    "Dashboard with real-time enrollment, payment, and attendance stats",
    "PDF template designer for admission letters and receipts",
    "Google Calendar integration",
    "Books and stationary inventory management"
  ],
